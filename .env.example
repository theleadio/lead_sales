# The same Supabase project as lead_crm: one database, one sign-in.
# lead_sales writes only its own `sales` schema (README, ground rules).
# Use a STAGING project for development, never production (build plan, 4 Nov).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe webhook (lib/payments/stripe-webhook.ts). Never committed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CRM <-> LMS (docs/specs/2026-11-04-crm-to-lms-handoff.md). Nothing is
# watched or sent unless LMS_HANDOFF_ENABLED is "true". The secret is shared
# with the LMS (HMAC) both ways. Never committed.
LMS_HANDOFF_ENABLED=
LMS_WEBHOOK_URL=https://class.thelead.io/api/crm/events
LMS_WEBHOOK_SECRET=
