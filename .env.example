# The same Supabase project as lead_crm: one database, one sign-in.
# lead_sales writes only its own `sales` schema (README, ground rules).
# Use a STAGING project for development, never production (build plan, 4 Nov).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe webhook (lib/payments/stripe-webhook.ts). Never committed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CRM <-> LMS (docs/specs/2026-11-04-crm-to-lms-handoff.md). Nothing is
# watched or sent unless LMS_HANDOFF_ENABLED is "true". The secret is shared
# with the LMS (HMAC) both ways. Never committed.
LMS_HANDOFF_ENABLED=
LMS_WEBHOOK_URL=https://class.thelead.io/api/crm/events
LMS_WEBHOOK_SECRET=

# Meta Lead Ads webhook (lib/meta/webhook.ts). The app secret signs Meta's
# deliveries; the verify token is any long random string, typed into Meta's
# webhook setup too. The Page access token needs leads_retrieval. Never
# committed.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0

# The public help form moved to lead_crm (its migration 019), with its
# RATE_LIMIT_SECRET, PUBLIC_ALLOWED_ORIGINS and TURNSTILE_SECRET_KEY.

# Email through Resend (lib/email/resend.ts), for automation send_email
# steps. Templates live in Resend as <template>-en / <template>-zh. EMAIL_FROM
# must be on a domain verified in Resend, e.g. LEAD <hello@thelead.io>.
# Without both, email steps fail with "not connected". Never committed.
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp template sends from automations (lib/wati/sender.ts), WATI API v3:
# the host only (e.g. https://live-mt-server.wati.io, no tenant id) and the
# token. The same values as lead_crm's. The WATI webhook, inbox replies and
# the history import are in lead_crm. Never committed.
WATI_API_HOST=
WATI_API_TOKEN=

# Funnel editor image uploads (public Supabase Storage bucket; service-role key stays server-side)
# Name of the public Storage bucket for editor images.
PAGE_IMAGE_BUCKET=
# Server-side only: lets the image upload route write to Storage.
SUPABASE_SERVICE_ROLE_KEY=

# Sites & Funnels (lib/sites). Empty here; set in the host's env. Never committed.
# Base URL of lead_crm, which owns lead registration and Stripe checkout.
CRM_BASE_URL=
# Key this app sends to lead_crm's public API.
PUBLIC_API_KEY=
# Salt (20+ chars) for the hashed visitor id behind unique page views.
PAGE_VIEW_SALT=
# Secret for the per-IP rate limits on the public site endpoints.
RATE_LIMIT_SECRET=
# Cloudflare Turnstile site key (public) shown on LEAD forms.
TURNSTILE_SITE_KEY=
# Netlify API token used to purge the CDN cache tag page:<id> on publish and settings save.
NETLIFY_PURGE_TOKEN=
# Netlify site id for those purges. Without both, purging is skipped.
NETLIFY_SITE_ID=
# Meta pixel id used for server-side CAPI events (Lead, InitiateCheckout, Purchase).
META_PIXEL_ID=
# Meta Conversions API access token.
META_CAPI_TOKEN=
# Meta Test Events code; leave empty in production.
META_TEST_EVENT_CODE=
