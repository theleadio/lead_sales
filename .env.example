# The same Supabase project as lead_crm: one database, one sign-in.
# lead_sales writes only its own `sales` schema (README, ground rules).
# Use a STAGING project for development, never production (build plan, 4 Nov).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe webhook (lib/payments/stripe-webhook.ts). Never committed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CRM <-> LMS (docs/specs/2026-11-04-crm-to-lms-handoff.md). Nothing is
# watched or sent unless LMS_HANDOFF_ENABLED is "true". The secret is shared
# with the LMS (HMAC) both ways. Never committed.
LMS_HANDOFF_ENABLED=
LMS_WEBHOOK_URL=https://class.thelead.io/api/crm/events
LMS_WEBHOOK_SECRET=

# Meta Lead Ads webhook (lib/meta/webhook.ts). The app secret signs Meta's
# deliveries; the verify token is any long random string, typed into Meta's
# webhook setup too. The Page access token needs leads_retrieval. Never
# committed.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0

# Public help form (lib/help/intake.ts). RATE_LIMIT_SECRET (16+ characters,
# server-only) keys the per-IP limit; without it the form stays closed.
# PUBLIC_ALLOWED_ORIGINS lists the website origins that may post to
# /api/public/help. TURNSTILE_SECRET_KEY turns the CAPTCHA on once a
# provider is chosen.
RATE_LIMIT_SECRET=
PUBLIC_ALLOWED_ORIGINS=
TURNSTILE_SECRET_KEY=

# WhatsApp through WATI (lib/wati). WATI documents no webhook signature, so
# the webhook address carries a secret:
#   https://<host>/api/webhooks/wati?token=<WATI_WEBHOOK_SECRET>
# Make it long and random (e.g. `openssl rand -hex 32`); without it the
# webhook answers 503. The API host and token are for sending (next PR):
# WATI_API_HOST is the host only, e.g. https://live-mt-server.wati.io, with
# no tenant id. Never committed.
WATI_WEBHOOK_SECRET=
WATI_API_HOST=
WATI_API_TOKEN=
